# Copy thành .env (không commit file .env).

# SQL Server. Bỏ trống để chạy thử bằng bộ nhớ tạm (mất dữ liệu khi tắt máy chủ).
# SQL Server cài trên máy (Express/Developer), đăng nhập SQL:
# MSSQL_CONNECTION_STRING=Server=localhost,1433;Database=InklineStudio;User Id=sa;Password=MatKhauCuaBan;Encrypt=true;TrustServerCertificate=true
MSSQL_CONNECTION_STRING=

# Dùng cho docker compose: mật khẩu sa của container SQL Server (ít nhất 8 ký tự, có chữ hoa, chữ thường, số, ký hiệu; không chứa dấu ;).
MSSQL_SA_PASSWORD=

# Mật khẩu tài khoản admin, chỉ dùng khi database chưa có tài khoản nào (ít nhất 10 ký tự).
# Bỏ trống thì máy chủ tự tạo và in ra terminal.
ADMIN_PASSWORD=

# Địa chỉ website, dùng cho sitemap.xml và metadata.
SITE_URL=http://localhost:3000

# Đặt 1 khi chạy qua HTTPS để cookie đăng nhập có cờ Secure.
COOKIE_SECURE=

# Email xác nhận yêu cầu đặt lịch gửi tới địa chỉ khách nhập trong form.
# Ví dụ Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER và SMTP_FROM là địa chỉ Gmail gửi; SMTP_PASSWORD là App Password.
# Không cấu hình thì lịch vẫn được lưu, giao diện sẽ báo chưa gửi email.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
